rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- yardımcılar ----------
    function signedIn() { return request.auth != null; }
    function roleOf(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        ? get(/databases/$(database)/documents/roles/$(uid)).data.role : null;
    }
    function isAdmin() { return signedIn() && roleOf(request.auth.uid) == 'admin'; }
    function isKoc()   { return signedIn() && roleOf(request.auth.uid) == 'koc'; }
    function myUser()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return signedIn() && myUser().get('aktif', true) != false; }
    // öğrenci gerçekten bu koça mı bağlı?
    function kocunOgrencisi(ogrId) {
      return get(/databases/$(database)/documents/users/$(ogrId)).data.get('kocId', null) == request.auth.uid;
    }
    function unchanged(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }

    // ---------- roller: sadece admin yazar ----------
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- kullanıcı profilleri ----------
    match /users/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || (isKoc() && isActive() && resource.data.get('kocId', null) == request.auth.uid)   // koç → kendi öğrencileri
        || (signedIn() && myUser().get('kocId', null) == uid);                               // öğrenci → kendi koçu
      allow write: if isAdmin();
    }

    // ---------- haftalık görevler ----------
    match /gorevler/{id} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.ogrenciId == request.auth.uid || resource.data.kocId == request.auth.uid));
      allow create: if isAdmin()
        || (isKoc() && isActive() && request.resource.data.kocId == request.auth.uid
            && kocunOgrencisi(request.resource.data.ogrenciId));
      allow update: if isAdmin()
        || (isKoc() && isActive() && resource.data.kocId == request.auth.uid
            && unchanged('kocId') && unchanged('ogrenciId'))
        // öğrenci sadece "tamam" ve "ogrenciNotu" alanlarını değiştirebilir
        || (isActive() && resource.data.ogrenciId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tamam', 'ogrenciNotu'])
            && request.resource.data.tamam is bool
            && request.resource.data.ogrenciNotu is string && request.resource.data.ogrenciNotu.size() <= 500);
      allow delete: if isAdmin() || (isKoc() && isActive() && resource.data.kocId == request.auth.uid);
    }

    // ---------- denemeler ----------
    match /denemeler/{id} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.ogrenciId == request.auth.uid || resource.data.kocId == request.auth.uid));
      allow create: if isAdmin()
        || (isActive() && request.resource.data.ogrenciId == request.auth.uid
            && request.resource.data.kocId == myUser().get('kocId', null))
        || (isKoc() && isActive() && request.resource.data.kocId == request.auth.uid
            && kocunOgrencisi(request.resource.data.ogrenciId));
      allow update: if isAdmin()
        || (isActive() && resource.data.ogrenciId == request.auth.uid && unchanged('ogrenciId') && unchanged('kocId'));
      allow delete: if isAdmin() || (isActive() && resource.data.ogrenciId == request.auth.uid);
    }

    // ---------- görüşme notları ----------
    match /gorusmeler/{id} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.ogrenciId == request.auth.uid || resource.data.kocId == request.auth.uid));
      allow create: if isAdmin()
        || (isKoc() && isActive() && request.resource.data.kocId == request.auth.uid
            && kocunOgrencisi(request.resource.data.ogrenciId));
      allow update, delete: if isAdmin()
        || (isKoc() && isActive() && resource.data.kocId == request.auth.uid && (request.method == 'delete' || (unchanged('kocId') && unchanged('ogrenciId'))));
    }

    // ---------- haftalık veli raporları (koç hazırlar → admin veliye gönderir) ----------
    // belge ID: {ogrenciId}_{haftaBaşı}
    match /veliRaporlari/{id} {
      allow read: if isAdmin() || (isKoc() && isActive() && (resource == null || resource.data.kocId == request.auth.uid));
      allow create: if isAdmin()
        || (isKoc() && isActive() && request.resource.data.kocId == request.auth.uid
            && kocunOgrencisi(request.resource.data.ogrenciId)
            && id == request.resource.data.ogrenciId + '_' + request.resource.data.hafta
            && request.resource.data.durum == 'bekliyor'
            && request.resource.data.metin is string && request.resource.data.metin.size() <= 3000);
      // koç, admin göndermeden önce raporunu güncelleyebilir
      allow update: if isAdmin()
        || (isKoc() && isActive() && resource.data.kocId == request.auth.uid && resource.data.durum == 'bekliyor'
            && request.resource.data.durum == 'bekliyor' && unchanged('kocId') && unchanged('ogrenciId') && unchanged('hafta')
            && request.resource.data.metin is string && request.resource.data.metin.size() <= 3000);
      allow delete: if isAdmin();
    }

    // ---------- öğrenci takip: konu durumu + hedef  (belge ID = öğrenci uid) ----------
    match /takip/{uid} {
      allow read: if isAdmin()
        || (isActive() && request.auth.uid == uid)
        || (isKoc() && isActive() && kocunOgrencisi(uid));
      allow write: if isAdmin()
        || (isActive() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['konular', 'hedef', 'updatedAt'])
            && (!('konular' in request.resource.data) || request.resource.data.konular is map)
            && (!('hedef' in request.resource.data) || request.resource.data.hedef is map));
    }

    // ---------- günlük soru sayacı (belge ID = {ogrenciId}_{tarih}) ----------
    match /soruKayit/{id} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.ogrenciId == request.auth.uid || resource.data.kocId == request.auth.uid));
      allow create, update: if isActive() && request.resource.data.ogrenciId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.tarih
        && request.resource.data.kocId == myUser().get('kocId', null)
        && request.resource.data.dersler is map && request.resource.data.toplam is number
        && request.resource.data.toplam >= 0 && request.resource.data.toplam <= 2000;
      allow delete: if isAdmin() || (isActive() && resource.data.ogrenciId == request.auth.uid);
    }

    // ---------- koç–öğrenci mesajlaşma ----------
    match /mesajlar/{id} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.ogrenciId == request.auth.uid || resource.data.kocId == request.auth.uid));
      allow create: if isActive() && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.okundu == false
        && ((request.resource.data.ogrenciId == request.auth.uid && request.resource.data.kocId == myUser().get('kocId', null))
            || (isKoc() && request.resource.data.kocId == request.auth.uid && kocunOgrencisi(request.resource.data.ogrenciId)));
      // alıcı sadece "okundu" alanını değiştirebilir
      allow update: if isAdmin()
        || (isActive() && resource.data.from != request.auth.uid
            && (resource.data.ogrenciId == request.auth.uid || resource.data.kocId == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okundu']));
      allow delete: if isAdmin();
    }

    // ---------- ödemeler / dönemler (admin yönetir, öğrenci kendininkini görür) ----------
    match /odemeler/{id} {
      allow read: if isAdmin() || (isActive() && resource.data.ogrenciId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------- ana sayfa başvuruları (herkes oluşturabilir, sadece admin görür) ----------
    function str(v, max) { return v is string && v.size() <= max; }

    match /ogrenciBasvurulari/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kim','ad','telefon','email','sinif','alan','hedef','kvkk','durum','createdAt'])
        && str(request.resource.data.ad, 80) && request.resource.data.ad.size() > 1
        && str(request.resource.data.telefon, 20) && request.resource.data.telefon.size() > 6
        && str(request.resource.data.email, 120) && str(request.resource.data.hedef, 600)
        && str(request.resource.data.sinif, 20) && str(request.resource.data.alan, 10)
        && request.resource.data.kim in ['ogrenci', 'veli']
        && request.resource.data.kvkk == true && request.resource.data.durum == 'yeni'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /mentorBasvurulari/{id} {
      allow create: if request.resource.data.keys().hasOnly(['ad','telefon','email','universite','bolum','alan','siralama','yil','neden','kvkk','durum','createdAt'])
        && str(request.resource.data.ad, 80) && request.resource.data.ad.size() > 1
        && str(request.resource.data.telefon, 20) && str(request.resource.data.email, 120)
        && str(request.resource.data.universite, 100) && str(request.resource.data.bolum, 100)
        && str(request.resource.data.alan, 10) && str(request.resource.data.neden, 800)
        && request.resource.data.siralama is number && request.resource.data.yil is number
        && request.resource.data.kvkk == true && request.resource.data.durum == 'yeni'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
