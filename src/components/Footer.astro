---
import { BRAND, ARACLAR } from "../config.js";
const yil = new Date().getFullYear();
---
<footer class="foot2"><div class="container">
  <div class="cols">
    <div>
      <a href="/" class="logo" style="margin-bottom:.8rem"><img src="/assets/logo-24-sm.png" alt="24 Akademi" style="height:52px;width:auto" /></a>
      <p class="muted small" style="max-width:280px">Derece yapmış üniversite öğrencilerinden birebir YKS koçluğu. {BRAND.slogan}.</p>
    </div>
    <div><h5>Platform</h5><a href="/#nasil">Nasıl çalışır</a><a href="/#panel">Panel</a><a href="/#fiyat">Fiyat</a><a href="/sss">SSS</a></div>
    <div><h5>YKS Araçları</h5>{ARACLAR.map((a) => <a href={a.href}>{a.ad}</a>)}</div>
    <div><h5>Kurumsal</h5><a href="/hakkimizda">Hakkımızda</a><a href="/koclar">Koçlarımız</a><a href="/koclar#koc-ol">Koç ol</a><a href="/iletisim">İletişim</a><a href="/portal" data-astro-reload>Panele giriş</a></div>
  </div>
  <div class="bottom"><span>© {yil} {BRAND.tamAd}</span>
    <span class="row" style="gap:1.2rem"><a href={BRAND.instagram} target="_blank" rel="noopener" style="color:inherit">{BRAND.instagramKullanici}</a><a href="/kvkk" style="color:inherit">KVKK Aydınlatma Metni</a></span></div>
</div></footer>
<div class="mcta" id="mcta"><a href="/#kayit" class="btn btn-accent">Ücretsiz ön görüşme</a></div>
<a class="wa-float" href={`https://wa.me/${BRAND.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
  <svg viewBox="0 0 32 32"><path d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.2.6 4.4 1.7 6.3L3 29l7.3-1.9c1.8 1 3.8 1.5 5.8 1.5 7 0 12.7-5.6 12.7-12.6S23 3 16 3zm0 23.1c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-4.3 1.1 1.2-4.2-.3-.4c-1-1.7-1.6-3.6-1.6-5.5C5.3 9.8 10.1 5.1 16 5.1s10.7 4.7 10.7 10.5S21.9 26.1 16 26.1zm5.9-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.1 1.4 3.4c.2.2 2.4 3.6 5.7 5 .8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.7-.4z"/></svg>
</a>
