---
// Koç kartları derleme sırasında HTML olarak üretilir (Google görür). Filtre: site.js → bindCoachFilter
import { KOCLAR } from "../config.js";
const { id = "coachGrid", filterId = "coachFilter", limit = 0 } = Astro.props;
const ALAN_AD = { SAY: "Sayısal", EA: "Eşit Ağırlık", SOZ: "Sözel", DIL: "Dil" };
const ini = (ad) => ad.split(" ").map((p) => p[0]).join("").slice(0, 2);
---
<div class="seg coach-filter" id={filterId}>
  <button class="on" data-a="">Tümü</button><button data-a="SAY">Sayısal</button><button data-a="EA">Eşit Ağırlık</button><button data-a="SOZ">Sözel</button><button data-a="DIL">Dil</button>
</div>
<div class="coaches" id={id} data-limit={limit || undefined}>
  {KOCLAR.map((k, i) => (
    <div class="coach" data-alan={k.alan} hidden={limit && i >= limit ? true : undefined}>
      <div class="coach-photo">
        {k.foto ? <img src={k.foto} alt={k.ad} loading="lazy" /> : <span class="coach-ini">{ini(k.ad)}</span>}
        <span class="coach-chip">{ALAN_AD[k.alan] || ""}</span>
        {k.ornek && <span class="coach-ornek">Örnek profil</span>}
      </div>
      <div class="coach-tag"><b>{k.ad}</b><span class="coach-school">{k.okul}</span><span class="coach-rank">{k.derece}</span></div>
    </div>
  ))}
  <div class="card empty coach-empty" style="grid-column:1/-1" hidden>Bu alandaki koçlarımız yakında burada. Ön görüşmede sana uygun koçu birlikte buluyoruz.</div>
</div>
