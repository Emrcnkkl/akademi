---
import Panel from "../layouts/Panel.astro";
---
<Panel title="Admin | 24 Akademi">
<div id="loading" class="login-wrap"><div class="muted">Yükleniyor…</div></div>

<div id="appView" class="hidden">
  <header class="app-top">
    <div class="container">
      <a href="/" class="logo"><img src="/assets/logo-24-sm.png" alt="24 Akademi" style="height:40px" /></a>
      <div class="user-chip">
        <span class="badge err">Yönetici</span>
        <span class="avatar" id="meAvatar"></span>
        <b id="meName"></b>
        <button class="btn btn-ghost btn-sm" id="logoutBtn">Çıkış</button>
      </div>
    </div>
  </header>
  <main class="app-main">
    <div class="container">
      <div class="spread"><div class="page-title">Yönetim paneli</div><button class="btn btn-accent btn-sm" id="newUserBtn">+ Yeni kullanıcı</button></div>
      <div class="tabs" id="aTabs" style="margin-top:1rem">
        <button class="on" data-t="genel">Genel bakış</button>
        <button data-t="ogrBas">Öğrenci başvuruları <span class="badge warn" id="cntOgr"></span></button>
        <button data-t="mentorBas">Koç başvuruları <span class="badge warn" id="cntMen"></span></button>
        <button data-t="rapor">Veli raporları <span class="badge warn" id="cntRap"></span></button>
        <button data-t="kullanici">Kullanıcılar</button>
      </div>
      <div id="aBody"></div>
    </div>
  </main>
</div>
</Panel>
<script>
  import "../scripts/admin.js";
</script>
